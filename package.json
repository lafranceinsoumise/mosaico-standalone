{
  "name": "mosaico-standalone",
  "version": "0.4.0",
  "private": true,
  "description": "Standalone email composer integrating Mosaico.",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "lint": "prettier . --check",
    "lint:fix": "prettier . --write",
    "test": "prettier . --check && NODE_ENV=test mocha --exit",
    "test:watch": "NODE_ENV=test mocha --watch",
    "hash-password": "node scripts/hash-password.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lafranceinsoumise/mosaico-standalone-composer.git"
  },
  "keywords": [
    "mosaico",
    "email",
    "composer",
    "responsive"
  ],
  "author": "Jill Royer <hello@jillroyer.me>",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/lafranceinsoumise/mosaico-standalone/issues"
  },
  "homepage": "https://github.com/lafranceinsoumise/mosaico-standalone",
  "dependencies": {
    "connect-redis": "^10.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.1",
    "moment": "^2.31.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.1.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pug": "^3.0.4",
    "redis": "^6.3.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
