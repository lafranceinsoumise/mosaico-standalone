{
  "name": "mosaico-standalone",
  "version": "0.3.0",
  "private": true,
  "description": "Standalone email composer integrating Mosaico.",
  "main": "index.js",
  "engines": {
    "node": ">=24.13.0"
  },
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "lint": "prettier . --check",
    "lint:fix": "prettier . --write",
    "test": "prettier . --check && NODE_ENV=test mocha --exit",
    "test:watch": "NODE_ENV=test mocha --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lafranceinsoumise/mosaico-standalone-composer.git"
  },
  "keywords": [
    "mosaico",
    "email",
    "composer",
    "responsive"
  ],
  "author": "Jill Royer <hello@jillroyer.me>",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/lafranceinsoumise/mosaico-standalone/issues"
  },
  "homepage": "https://github.com/lafranceinsoumise/mosaico-standalone",
  "dependencies": {
    "bluebird": "^3.7.2",
    "body-parser": "^2.2.2",
    "connect-redis": "^9.0.0",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "formidable": "3.5.4",
    "gm": "^1.25.1",
    "mkdirp": "3.0.1",
    "moment": "^2.30.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mz": "^2.7.0",
    "nodemailer": "^7.0.12",
    "nodemailer-html-to-text": "^3.2.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pug": "^3.0.3",
    "redis": "^5.10.0",
    "request": "^2.88.2",
    "sanitize-html": "^2.17.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "uuid": "^13.0.0",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "mocha": "^11.7.5",
    "prettier": "3.8.0",
    "supertest": "^7.2.2"
  }
}
