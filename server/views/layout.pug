doctype
html
  head
    link(href="https://cdn.jsdelivr.net/npm/bootswatch@3.4.1/journal/bootstrap.min.css", rel="stylesheet", integrity="sha384-T+Z3XwwI21wMyfe0vTxryTqEfv0fxK9gMuolkXbN8HEzFNFSKVyZiRvPQ0Xu4QF0", crossorigin="anonymous")
    style.
      html {
        height: 100%;
      }

      body {
        height: 100%;
        display: flex;
        flex-direction: column;
      }

      .wrapper {
        flex: 1 1 auto;
        display: flex;
      }

      .wrapper #editor {
        margin-top:-20px;
        width:100%;
      }
  body
    block body
      nav.navbar.navbar-default
        .container
          .collapse.navbar-collapse
            ul.nav.navbar-nav
              li
                a(href="/storage/list") Emails
            ul.nav.navbar-nav.navbar-right
              li.dropdown
                a(href="#", data-toggle="dropdown", role="button", aria-haspopup="true", aria-expanded="false").dropdown-toggle #{user} <span class="caret"></span>
                ul.dropdown-menu
                  li
                    form(method="post", action="/logout")
                      button.btn.btn-link(type="submit") Logout
      .wrapper
        block content
          .container
            .row
              .col-xs-12.col-sm-10.col-sm-offset-1.col-md-8.col-md-offset-2.col-lg-6.col-lg-offset-3
                block one-column
    script(src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js", integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs", crossorigin="anonymous")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.4.1/js/bootstrap.min.js", integrity="sha384-aJ21OjlMXNL5UyIl/XNwTMqvzeRMZH2w8c5cRVpzpU8Y5bApTppSuUkhZXN0VxHd", crossorigin="anonymous")
